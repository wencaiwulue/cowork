{
  "name": "claude-code-source-snapshot-local",
  "version": "999.0.0-local",
  "description": "Local Claude Code desktop and CLI development build.",
  "author": "Anthropic",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "22.18.0"
  },
  "bin": {
    "claude-local": "./dist/claude-local"
  },
  "scripts": {
    "start": "bun src/entrypoints/cli.tsx",
    "check": "tsc --noEmit",
    "build": "node desktop/scripts/build-cli.mjs",
    "build:darwin-arm64": "CLI_CROSS_TARGET=bun-darwin-arm64 node desktop/scripts/build-cli-cross.mjs",
    "desktop:check": "bun run build && bun run desktop:build-main && npx vite build --config desktop/vite.config.ts",
    "desktop:dev": "node desktop/scripts/dev.mjs",
    "desktop:test": "vitest run --config desktop/vitest.config.ts",
    "desktop:smoke-runtime": "bun run build && node desktop/scripts/smoke-runtime.mjs",
    "desktop:smoke-electron": "bun run build && bun run desktop:build-main && vite build --config desktop/vite.config.ts && node desktop/scripts/smoke-electron.mjs",
    "desktop:smoke-packaged": "bun run desktop:build && node desktop/scripts/smoke-packaged.mjs",
    "desktop:build-main": "vite build --config desktop/vite.main.config.ts && vite build --config desktop/vite.preload.config.ts",
    "desktop:build": "node desktop/scripts/build-desktop.mjs",
    "desktop:verify-release": "node desktop/scripts/verify-release-artifacts.mjs",
    "desktop:write-published-release-evidence": "node desktop/scripts/published-release-evidence.mjs generate --release-json desktop/release/publish/github-release.json --downloaded-dir desktop/release/publish/downloaded --output desktop/release/publish/published-release-evidence.json",
    "desktop:verify-published-release": "node desktop/scripts/published-release-evidence.mjs verify --local desktop/release/publish/published-release-evidence.json --evidence desktop/release/publish/downloaded-evidence/published-release-evidence.json --downloaded-dir desktop/release/publish/downloaded",
    "desktop:write-public-release-evidence": "node desktop/scripts/published-release-evidence.mjs generate-public --release-json public-release.json --output public-release-evidence.json",
    "desktop:verify-public-release": "node desktop/scripts/published-release-evidence.mjs verify-public --evidence public-release-evidence.json --production-gate-evidence public-release-input/production-gate-evidence.json --published-evidence public-release-input/published-evidence/published-release-evidence.json",
    "desktop:prepare-ux-validation": "node desktop/scripts/ux-validation-evidence.mjs",
    "desktop:release-preflight": "node desktop/scripts/release-ci.mjs preflight:all",
    "desktop:release-ci": "node desktop/scripts/release-ci.mjs",
    "desktop:production-gate": "node desktop/scripts/production-gate.mjs",
    "desktop:verify-production-gate-evidence": "node desktop/scripts/production-gate.mjs verify --evidence desktop/release/production-gate-evidence.json --published-evidence desktop/release/publish/downloaded-evidence/published-release-evidence.json",
    "desktop:prod-check": "node desktop/scripts/production-readiness.mjs",
    "wcommit": "node scripts/weekend-commit.mjs"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "latest",
    "@ant/claude-for-chrome-mcp": "file:./stubs/ant-claude-for-chrome-mcp",
    "@ant/computer-use-input": "file:./stubs/ant-computer-use-input",
    "@ant/computer-use-mcp": "file:./stubs/ant-computer-use-mcp",
