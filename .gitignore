.DS_Store
.idea/
.playwright-mcp/

# Local dependencies and package-manager caches. Existing tracked dependency
# snapshot files remain tracked; this prevents newly installed packages from
# being staged accidentally.
node_modules/

# Desktop build and release outputs are regenerated by the documented scripts
# and archived by release CI.
desktop/dist/
desktop/release/

# Local CLI binary produced by `bun run build`.
dist/claude-local
dist/
*.node
