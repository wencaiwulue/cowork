{
  "appId": "com.anthropic.claude-code-desktop",
  "productName": "Claude Code Desktop",
  "directories": {
    "output": "desktop/release"
  },
  "files": [
    "desktop/dist/**/*",
    "desktop/release-policy.json",
    "package.json",
    "!node_modules/**/*",
    "node_modules/node-pty/**/*",
    "!node_modules/node-pty/**/*.map",
    "!node_modules/node-pty/lib/*.test.js",
    "!node_modules/node-pty/src/**/*",
    "!node_modules/node-pty/deps/**/*"
  ],
  "extraResources": [
    {
      "from": "dist/claude-local",
      "to": "dist/claude-local"
    },
    {
      "from": "node_modules/node-pty",
      "to": "node_modules/node-pty",
      "filter": [
        "package.json",
        "lib/**",
        "!lib/**/*.test.js",
        "!lib/**/*.test.js.map",
        "!lib/**/*.map",
        "prebuilds/darwin-arm64/**"
      ]
    }
  ],
  "extraMetadata": {
    "main": "desktop/dist/main/main.js"
  },
  "mac": {
    "category": "public.app-category.developer-tools",
    "icon": "desktop/assets/icon.icns",
    "hardenedRuntime": true,
    "forceCodeSigning": true,
    "notarize": true,
    "entitlements": "desktop/build/entitlements.mac.plist",
    "entitlementsInherit": "desktop/build/entitlements.mac.inherit.plist",
    "target": ["dmg", "zip"]
  },
  "win": {
    "target": ["nsis"]
  },
  "linux": {
    "target": ["AppImage"]
  }
}
